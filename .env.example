# ====================================================================
# Foodie BD (খাদক ম্যাপ) Environment Variables Reference
# ====================================================================

# 1. CORE RUNTIME CONFIGURATION
NODE_ENV="development" # Set to "production" in production environments
PORT="3000"

# 2. REQUIRED FOR PRODUCTION / VERCEL DEPLOYMENT
# PostgreSQL pooled connection string (e.g. Supabase Transaction Pooler, Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase API credentials (used for Supabase Storage bucket 'food-images' and auth)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-ANON-PUBLIC-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-SECRET-KEY]"
SUPABASE_STORAGE_BUCKET="food-images"

# Authentication Security (Minimum 32 random characters in production; do not use default key)
JWT_SECRET="replace-with-a-cryptographically-secure-random-32-char-string"

# One-time Admin Setup Authorization (Minimum 16 characters; locked after first admin exists)
ADMIN_SETUP_KEY="replace-with-a-secure-admin-bootstrap-key-min-16-chars"

# 3. OPTIONAL AI & HOSTING METADATA
# Automatically populated in AI Studio runtime; optional elsewhere
GEMINI_API_KEY="your-gemini-api-key"
APP_URL="https://your-domain.vercel.app"
